<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {% if legacyRedirect %}
  <script>
    // Legacy deep-link redirect: before the app moved to /webapp/, shared
    // links and the sitemap pointed crag/region params at the root URL
    // (e.g. climbable.app/?crag=arap-main, climbable.app/?region=VIC).
    // Forward those straight into the app with the same query string so
    // old bookmarks, shared links and installed PWA shortcuts keep working.
    (function () {
      var params = new URLSearchParams(location.search);
      if (params.has('crag') || params.has('region')) {
        location.replace('/webapp/' + location.search);
      }
    })();
  </script>
  {% endif %}
  <title>{{ seo.title }}</title>
  <meta name="description" content="{{ seo.description }}" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://climbable.app{{ page.url }}" />

  <meta property="og:title" content="{{ seo.title }}" />
  <meta property="og:description" content="{{ seo.description }}" />
  <meta property="og:image" content="https://climbable.app/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content="https://climbable.app{{ page.url }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Climbable" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ seo.title }}" />
  <meta name="twitter:description" content="{{ seo.description }}" />
  <meta name="twitter:image" content="https://climbable.app/og-image.png" />

  <link rel="preconnect" href="https://api.fontshare.com" />
  <link href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" rel="stylesheet" />
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="{{ rootPath | default('./') }}base.css" />
  <link rel="stylesheet" href="{{ rootPath | default('./') }}style.css?v={{ cssVersion }}" />
</head>
<body>

  {% include "header.njk" %}

  <main id="top">
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  <script>
    (function () {
      const t = document.querySelector('[data-theme-toggle]'),
        r = document.documentElement;
      let d = matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light';
      r.setAttribute('data-theme', d);
      t &&
        t.addEventListener('click', () => {
          d = d === 'dark' ? 'light' : 'dark';
          r.setAttribute('data-theme', d);
          t.setAttribute('aria-label', 'Switch to ' + (d === 'dark' ? 'light' : 'dark') + ' mode');
        });
    })();
  </script>

  {% if includeMapScript %}
  <script>
    (function () {
      const map = document.querySelector('.coverage-map');
      const tooltip = document.getElementById('coverage-tooltip');
      if (!map || !tooltip) return;
      const stateEl = tooltip.querySelector('.coverage-map-tooltip-state');
      const countEl = tooltip.querySelector('.coverage-map-tooltip-count');
      const listEl = tooltip.querySelector('.coverage-map-tooltip-list');
      const noteEl = tooltip.querySelector('.coverage-map-tooltip-note');
      const wrap = map.closest('.coverage-map-wrap');

      function showTooltip(el) {
        const name = el.getAttribute('data-name');
        const count = parseInt(el.getAttribute('data-count'), 10);
        const note = el.getAttribute('data-note');
        stateEl.textContent = name;
        listEl.innerHTML = '';
        if (count > 0) {
          countEl.textContent = count + (count === 1 ? ' destination' : ' destinations');
          const crags = note ? note.split('|').filter(Boolean) : [];
          crags.forEach((crag) => {
            const li = document.createElement('li');
            li.textContent = crag;
            listEl.appendChild(li);
          });
          noteEl.textContent = '';
        } else {
          countEl.textContent = 'Not yet covered';
          noteEl.textContent = 'More states are on the way.';
        }
        tooltip.hidden = false;

        const wrapRect = wrap.getBoundingClientRect();
        const bbox = el.getBoundingClientRect();
        const x = bbox.left + bbox.width / 2 - wrapRect.left;
        const topSpace = bbox.top - wrapRect.top;
        const tooltipHeight = tooltip.offsetHeight || 100;
        const showBelow = topSpace < tooltipHeight + 20;
        tooltip.classList.toggle('coverage-map-tooltip--below', showBelow);
        const y = showBelow ? bbox.bottom - wrapRect.top : topSpace;
        tooltip.style.left = Math.max(125, Math.min(x, wrapRect.width - 125)) + 'px';
        tooltip.style.top = y + 'px';
      }

      map.querySelectorAll('.map-state').forEach((el) => {
        el.setAttribute('tabindex', '0');
        el.setAttribute('role', 'button');
        el.addEventListener('mouseenter', () => showTooltip(el));
        el.addEventListener('focus', () => showTooltip(el));
        el.addEventListener('click', () => showTooltip(el));
        el.addEventListener('mouseleave', () => {
          tooltip.hidden = true;
        });
        el.addEventListener('blur', () => {
          tooltip.hidden = true;
        });
      });
    })();
  </script>
  {% endif %}
</body>
</html>
