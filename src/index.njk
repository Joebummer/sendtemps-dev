---
layout: base.njk
legacyRedirect: true
includeMapScript: true
eleventyComputed:
  seo:
    title: "{{ home.seo.title }}"
    description: "{{ home.seo.description }}"
---
{% set h = home.hero %}
{% set p = home.problem %}
{% set hiw = home.how_it_works %}
{% set sc = home.scores %}
{% set cov = home.coverage %}
{% set pr = home.pricing %}
{% set fc = home.footer_cta %}

<!-- ============ 1. HERO ============ -->
<section class="hero wrap" aria-labelledby="hero-title">
  <img class="hero-mark" src="images/brand/app-icon-256.png" width="56" height="56" alt="SendTemps logo">
  <div class="hero-eyebrow">{{ h.eyebrow }}</div>
  <h1 id="hero-title" class="hero-title">{{ h.title }}</h1>
  <p class="hero-sub">{{ h.subtitle }}</p>
  <div class="hero-cta-row">
    <a class="btn btn-primary" href="/webapp/">{{ h.cta_primary_label }}</a>
    <a class="btn btn-ghost" href="#coverage">{{ h.cta_secondary_label }}</a>
  </div>
  <div class="hero-proof">
    {% for point in h.proof_points %}
    <span>{{ point }}</span>
    {% endfor %}
  </div>
</section>

<!-- ============ 2. THE PROBLEM ============ -->
<section id="problem" class="section">
  <div class="wrap">
    <div class="section-tag">{{ p.tag }}</div>
    <div class="grid-2">
      <div>
        <h2 class="section-heading">{{ p.heading }}</h2>
        <p class="section-note">{{ p.body_1 }}</p>
        <p class="section-note" style="margin-top: var(--space-4);">{{ p.body_2 }}</p>
      </div>
      <div class="phone-compare-row">
        <div class="phone-compare-item">
          <div class="phone-compare-label">{{ p.compare_generic_label }}</div>
          <div class="phone-frame">
            <div class="phone-frame-screen">
              <img src="{{ p.compare_generic_image | default('/images/phones/generic-weather-app.jpg') }}" alt="A generic weather app showing only a basic temperature and rain forecast for Halls Gap, VIC, with no climbing-specific detail" loading="lazy">
            </div>
          </div>
        </div>
        <div class="phone-compare-item">
          <div class="phone-compare-label is-brand">{{ p.compare_sendtemps_label }}</div>
          <div class="phone-frame">
            <div class="phone-frame-screen">
              <img src="{{ p.compare_sendtemps_image | default('/images/phones/sendtemps-crag-detail.jpg') }}" alt="Climbable showing a detailed climbing-specific forecast for the Grampians, including a daily conditions score, rock dryness, wind, humidity, cloud cover, and hour-by-hour breakdown" loading="lazy">
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="problem-cta-row">
      <a class="btn btn-primary problem-cta-app" href="/webapp/">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="2" width="18" height="20" rx="3.2" stroke="currentColor" stroke-width="1.6"/>
          <path d="M12 8V15M12 15L9 12.3M12 15L15 12.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M9 18.5H15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        {{ p.app_cta_label }}
      </a>
    </div>
    <div class="grid-2" style="margin-top: var(--space-16);">
      <div>
        <h3 class="section-heading" style="font-size: var(--text-lg);">{{ p.subsection_heading }}</h3>
        <p class="section-note">{{ p.subsection_body_1 }}</p>
      </div>
      <div>
        <p class="section-note">{{ p.subsection_body_2 }}</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ 3. HOW IT WORKS ============ -->
<section id="how-it-works" class="section">
  <div class="wrap">
    <div class="section-tag">{{ hiw.tag }}</div>
    <h2 class="section-heading">{{ hiw.heading }}</h2>
    <div class="steps-row">
      {% for step in hiw.steps %}
      <div class="step-block">
        <h3 class="section-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-2);">{{ step.title }}</h3>
        <p class="section-note">{{ step.body }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="feature-phone-grid">
      <div class="feature-phone-grid-copy">
        <h3 class="section-heading" style="font-size: var(--text-lg);">{{ hiw.feature_heading }}</h3>
        <p class="section-note">{{ hiw.feature_body_1 }}</p>
        <p class="section-note" style="margin-top: var(--space-4);">{{ hiw.feature_body_2 }}</p>
      </div>
      <div class="feature-phone-grid-frame">
        <div class="phone-frame">
          <div class="phone-frame-screen">
            <img src="{{ hiw.feature_image | default('/images/phones/sendtemps-trip-planning.jpg') }}" alt="Climbable multi-day trip planning screen for Mt Buffalo showing a rare-window trip score of 91, a Friday-to-Monday outlook with best wall per day, and a sub-crag breakdown with individual scores" loading="lazy">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 4. WHAT IT ACTUALLY SCORES ============ -->
<section id="scores" class="section">
  <div class="wrap">
    <div class="section-tag">{{ sc.tag }}</div>
    <h2 class="section-heading">{{ sc.heading }}</h2>
    <p class="section-note" style="margin-bottom: var(--space-8);">{{ sc.intro }}</p>
    <div class="scores-grid">
      {% set icons = [
        '<circle cx="14" cy="14" r="5.5" stroke="currentColor" stroke-width="1.6"/><path d="M14 2.5V6M14 22V25.5M25.5 14H22M6 14H2.5M21.6 6.4L19.1 8.9M21.6 21.6L19.1 19.1M6.4 6.4L8.9 8.9M6.4 21.6L8.9 19.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
        '<path d="M14 3C14 3 8 12.5 8 17.5C8 20.8 10.7 23.5 14 23.5C17.3 23.5 20 20.8 20 17.5C20 12.5 14 3 14 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M11 18C11 19.66 12.34 21 14 21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
        '<path d="M8 15C5.24 15 3 12.76 3 10C3 7.24 5.24 5 8 5C8.6 5 9.17 5.11 9.7 5.31C10.6 3.36 12.58 2 14.9 2C17.94 2 20.42 4.35 20.65 7.32C23.11 7.7 25 9.83 25 12.4C25 15.2 22.73 17.47 19.93 17.47H9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/><path d="M9 21L7.5 24M14 21L12.5 24M19 21L17.5 24" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
        '<path d="M14 4C14 4 20 12.2 20 17.2C20 20.4 17.3 23 14 23C10.7 23 8 20.4 8 17.2C8 12.2 14 4 14 4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4.5 11.5C4.5 11.5 3.5 13 3.5 14.3C3.5 15.6 4.4 16.6 5.6 16.6M23.5 11.5C23.5 11.5 24.5 13 24.5 14.3C24.5 15.6 23.6 16.6 22.4 16.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
        '<path d="M3 10H16.5C18.5 10 20 8.5 20 6.7C20 4.9 18.5 3.5 16.7 3.5C15.2 3.5 13.9 4.5 13.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 16H20.5C22.5 16 24 17.5 24 19.3C24 21.1 22.5 22.5 20.7 22.5C19.2 22.5 17.9 21.5 17.5 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 22.5H11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
        '<path d="M4 22L9.5 12L13 16L18.5 8L24 22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M18.5 8L20.5 8.5M18.5 8L18 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><circle cx="18.5" cy="8" r="1.1" fill="currentColor"/>'
      ] %}
      {% for card in sc.cards %}
      <div class="content-block score-card">
        <svg class="score-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">{{ icons[loop.index0] | safe }}</svg>
        <p class="score-title">{{ card.title }}</p>
        <p class="score-desc">{{ card.body }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="feature-phone-grid is-reverse">
      <div class="feature-phone-grid-copy">
        <h3 class="section-heading" style="font-size: var(--text-lg);">{{ sc.feature_heading }}</h3>
        <p class="section-note">{{ sc.feature_body | safe }}</p>
      </div>
      <div class="feature-phone-grid-frame">
        <div class="phone-frame">
          <div class="phone-frame-screen">
            <img src="{{ sc.feature_image | default('/images/phones/sendtemps-score-breakdown.jpg') }}" alt="Climbable score breakdown for Cape Raoul showing an 85/100 day score with a Why this score panel listing temperature, sweet spot mismatch, and sun on wall factors as plus or minus points, plus crag notes and aspect tags" loading="lazy">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ 5. COVERAGE ============ -->
<section id="coverage" class="section">
  <div class="wrap">
    <div class="section-tag">{{ cov.tag }}</div>
    <h2 class="section-heading">{{ cov.heading }}</h2>
    <p class="section-note" style="margin-bottom: var(--space-8);">{{ cov.intro }}</p>
    <div class="coverage-map-wrap">
      {% include "coverage-map.njk" %}
      <div class="coverage-map-tooltip" id="coverage-tooltip" hidden>
        <span class="coverage-map-tooltip-state"></span>
        <span class="coverage-map-tooltip-count"></span>
        <ul class="coverage-map-tooltip-list"></ul>
        <span class="coverage-map-tooltip-note"></span>
      </div>
    </div>
    <div class="coverage-list" style="margin-top: var(--space-10);">
      {% for item in cov.list %}
      <div class="content-block"><strong>{{ item.state }}</strong> – {{ item.body }}</div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============ 6. FREE VS PRO ============ -->
<section id="pricing" class="section">
  <div class="wrap">
    <div class="section-tag">{{ pr.tag }}</div>
    <h2 class="section-heading">{{ pr.heading }}</h2>
    <div class="tier-compare" style="margin-top: var(--space-6);">
      <div class="content-block">
        <strong style="color: var(--color-text); display:block; margin-bottom: var(--space-4); font-size: var(--text-lg);">{{ pr.free_title }}</strong>
        <ul class="tier-feature-list">
          {% for feature in pr.free_features %}
          <li>{{ feature | mdInline | safe }}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="content-block">
        <strong style="color: var(--color-text); display:block; margin-bottom: var(--space-4); font-size: var(--text-lg);">{{ pr.pro_title }}</strong>
        <ul class="tier-feature-list">
          {% for feature in pr.pro_features %}
          <li>{{ feature | mdInline | safe }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="hero-cta-row" style="margin-top: var(--space-6);">
      <a class="btn btn-primary" href="/webapp/">{{ pr.cta_label }}</a>
    </div>
  </div>
</section>

<!-- ============ 8. FOOTER CTA ============ -->
<section id="footer-cta" class="section" style="border-bottom: none;">
  <div class="wrap" style="text-align:center;">
    <h2 class="section-heading" style="font-size: var(--text-2xl);">{{ fc.heading }}</h2>
    <div class="hero-cta-row" style="margin-top: var(--space-6);">
      <a class="btn btn-primary" href="/webapp/">{{ fc.cta_primary_label }}</a>
      <a class="btn btn-ghost" href="mailto:hello@climbable.app">{{ fc.cta_secondary_label }}</a>
    </div>
  </div>
</section>
